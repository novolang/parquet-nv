// pqarrow_tests.nv — the bridge to arrow-nv: the type mapping and its
// named gaps, levels into offsets, a chunk into an array, and the Arrow
// schema a footer carries.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: parquet-nv.<module>.<fn>`.
//
// THE CASES ARE THE GAPS.  Most of the mapping is one type to one type
// and is asserted once.  What gets a case of its own is where the two
// formats disagree: the zone that says whether a timestamp is a wall
// clock, the Arrow types Parquet cannot store, the INT96 dates an Int64
// of nanoseconds cannot reach, and the three-level LIST that is one
// field in Arrow.

use std.test
use std.list
use pqarrow
use arrowtype
use arrowcol
use arrowbuf

// The bytes a hex string spells.
fn hex(text: Str) -> Bytes
    bytes.from_hex(text) ?? bytes.zeros(0)

// A destination with room for `n` bytes.
fn room(n: Int) -> Cursor
    bytes.cursor_le(bytes.zeros(n))

// A codec configuration with a window the test chose.
fn a_config() -> PqCodecConfig
    PqCodecConfig { gzip_format: GzipWrapped, zstd_window_limit: 1048576, zstd_level: 3 }

// A schema element, built rather than asked for, so a test's first red
// names the call it is about.
fn element(name: Str, repetition: PqRepetition, physical: PqPhysical, logical: PqLogical,
           children: [PqSchemaElement]) -> PqSchemaElement
    PqSchemaElement { name: name, repetition: repetition, physical: physical, type_length: 0,
                      converted: PqConvNone, logical: logical, children: children[:],
                      field_id: 0 - 1 }

// `optional group items (LIST) { repeated group list { optional int64
// element } }`
fn three_level_list() -> PqSchemaElement
    let e = element("element", PqOptional, PqInt64, PqLogNone, [])
    let l = element("list", PqRepeated, PqInt64, PqLogNone, [e])
    element("items", PqOptional, PqInt64, PqLogList, [l])

// A flat leaf directly under the root.
fn flat_column(name: Str, physical: PqPhysical, max_definition: Int) -> PqColumn
    PqColumn { path: name, segments: [name], physical: physical, type_length: 0,
               logical: PqLogNone, max_definition_level: max_definition,
               max_repetition_level: 0 }

// A required INT64 column `qty`, alone in its schema.
fn qty() -> PqColumn
    flat_column("qty", PqInt64, 0)

// The schema holding `qty` and nothing else.
fn qty_schema() -> PqSchema
    let root = element("schema", PqRequired, PqInt64, PqLogNone,
                       [element("qty", PqRequired, PqInt64, PqLogNone, [])])
    PqSchema { root: root, columns: [qty()] }

// A schema of an optional DOUBLE and a required INT64.
fn two_leaves() -> PqSchema
    let root = element("schema", PqRequired, PqInt64, PqLogNone,
                       [element("price", PqOptional, PqDouble, PqLogNone, []),
                        element("qty", PqRequired, PqInt64, PqLogNone, [])])
    PqSchema { root: root, columns: [flat_column("price", PqDouble, 1), qty()] }

// Statistics with nothing claimed.
fn nothing_claimed() -> PqStats
    PqStats { min_span: arrowbuf.buffer(0, 0), max_span: arrowbuf.buffer(0, 0), has_min: false,
              has_max: false, min_value_span: arrowbuf.buffer(0, 0),
              max_value_span: arrowbuf.buffer(0, 0), has_min_value: false, has_max_value: false,
              null_count: 0, has_null_count: false, distinct_count: 0,
              has_distinct_count: false, is_max_value_exact: false, is_min_value_exact: false }

// The one chunk of `qty`: ten values at file offset 1000, uncompressed.
fn qty_chunk() -> PqColumnChunk
    PqColumnChunk { path: "qty", physical: PqInt64, codec: PqUncompressed, num_values: 10,
                    total_uncompressed_size: 99, total_compressed_size: 99,
                    data_page_offset: 1000, dictionary_page_offset: 0 - 1,
                    offset_index_offset: 0 - 1, offset_index_length: 0,
                    column_index_offset: 0 - 1, column_index_length: 0, encodings: [PqPlain],
                    stats: nothing_claimed(), has_stats: false }

// The chunk's bytes: a 19-byte v1 header (type 0, eighty bytes either
// way, ten values, PLAIN, RLE levels) and ten INT64 zeros.
fn qty_chunk_bytes() -> Bytes
    hex("1500" + "15a001" + "15a001" + "2c" + "1514" + "1500" + "1506" + "1506" + "00" + "00"
        + str.repeat("00", 80))

// A footer of that one chunk in one row group, with or without the
// Arrow schema entry.
fn qty_footer(metadata: [PqKeyValue]) -> PqFileMeta
    let g = PqRowGroup { columns: [qty_chunk()], num_rows: 10, total_byte_size: 99,
                         file_offset: 0 - 1, ordinal: 0 }
    PqFileMeta { version: 1, schema: qty_schema(), num_rows: 10, row_groups: [g],
                 key_value_metadata: metadata[:], created_by: "parquet-nv 0.0.3" }

// The footer entry an Arrow writer leaves.
fn arrow_entry() -> PqKeyValue
    PqKeyValue { key: "ARROW:schema", value: "/////w==", has_value: true }

// A writer past its opening magic, with a row group open.
fn qty_writer() -> PqWriter
    PqWriter { schema: qty_schema(), codec: PqUncompressed, config: a_config(), written: 4,
               row_groups: [], open_chunks: [], open_rows: 0, key_value_metadata: [],
               created_by: "", started: true }

// Three INT64 values with no nulls, over a 24-byte body.
fn three_ints() -> arrowcol.ArrowArray
    arrowcol.array(ArrowInt64, 3, 0, [arrowbuf.no_buffer(), arrowbuf.buffer(0, 24)])

// ── The type mapping ────────────────────────────────────────────────

@test
fn test_a_parquet_type_and_its_annotation_decide_the_arrow_type_together() [io]
    test.case("a DOUBLE is a Float64")
    match pqarrow.arrow_type_of(PqDouble, PqLogNone, 0)
        Ok(ArrowFloat64) => test.assert(true)
        _                => test.assert(false)

    test.case("an INT32 annotated DATE is a Date32")
    match pqarrow.arrow_type_of(PqInt32, PqLogDate, 0)
        Ok(ArrowDate32) => test.assert(true)
        _               => test.assert(false)

    test.case("a timestamp adjusted to UTC carries the zone UTC")
    match pqarrow.arrow_type_of(PqInt64, PqLogTimestamp(true, PqMicros), 0)
        Ok(ArrowTimestamp(_, zone)) => test.assert_eq(zone, "UTC")
        _                           => test.assert(false)

    test.case("and one that is not carries the empty zone, the wall clock")
    match pqarrow.arrow_type_of(PqInt64, PqLogTimestamp(false, PqMicros), 0)
        Ok(ArrowTimestamp(_, zone)) => test.assert_eq(zone, "")
        _                           => test.assert(false)

@test
fn test_the_arrow_types_parquet_cannot_store_are_refused_by_name() [io]
    test.case("a string is a BYTE_ARRAY annotated STRING")
    match pqarrow.parquet_type_of(ArrowUtf8)
        Err(_) => test.assert(false)
        Ok(t)  =>
            match t.0
                PqByteArray => test.assert(true)
                _           => test.assert(false)
            match t.1
                PqLogString => test.assert(true)
                _           => test.assert(false)

    test.case("Null, a union and an interval have no Parquet spelling")
    match pqarrow.parquet_type_of(ArrowNull)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match pqarrow.parquet_type_of(ArrowUnion(ArrowSparseUnion))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match pqarrow.parquet_type_of(ArrowInterval(ArrowYearMonth))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_an_int96_date_outside_1677_to_2262_loses_range_as_nanoseconds() [io]
    test.case("1970-01-01 is Julian day 2440588, well inside")
    test.assert(pqarrow.int96_is_lossy(2440588) == false)

    test.case("a date in 1500 and a date in 2300 are not")
    test.assert(pqarrow.int96_is_lossy(2268924))
    test.assert(pqarrow.int96_is_lossy(2561118))

@test
fn test_an_int96_is_nanoseconds_of_the_day_then_a_julian_day() [io]
    // 1000 ns into Julian day 2440588, the epoch
    let page = hex("e803000000000000" + "8c3d2500")

    match pqarrow.int96_to_nanos(page, arrowbuf.buffer(0, 12))
        Ok(n)  => test.assert_eq(n, 1000)
        Err(_) => test.assert(false)

// ── Schemas ─────────────────────────────────────────────────────────

@test
fn test_a_three_level_list_becomes_one_arrow_list_field_with_one_child() [io]
    match pqarrow.arrow_field_of(three_level_list())
        Err(_) => test.assert(false)
        Ok(f)  =>
            test.assert_eq(f.name, "items")
            test.assert(f.nullable)
            match f.data_type
                ArrowList => test.assert(true)
                _         => test.assert(false)
            test.assert_eq(list.len(f.children), 1)

@test
fn test_a_parquet_schema_becomes_one_arrow_field_per_top_level_element() [io]
    match pqarrow.arrow_schema_of(two_leaves())
        Err(_) => test.assert(false)
        Ok(s)  =>
            test.assert_eq(list.len(s.fields), 2)
            test.assert_eq(s.fields[0].name, "price")
            test.assert(s.fields[0].nullable)
            test.assert(s.fields[1].nullable == false)

@test
fn test_an_arrow_list_is_written_with_the_specifications_inner_names() [io]
    let f = arrowtype.nested_field("items", ArrowList, true, [arrowtype.field("item", ArrowInt64,
                                                                               true)])

    match pqarrow.parquet_element_of(f)
        Err(_) => test.assert(false)
        Ok(e)  =>
            test.assert_eq(list.len(e.children), 1)
            test.assert_eq(e.children[0].name, "list")
            test.assert_eq(e.children[0].children[0].name, "element")

@test
fn test_an_arrow_schema_becomes_a_parquet_schema_of_its_leaves() [io]
    let s = arrowtype.schema([arrowtype.field("price", ArrowFloat64, true),
                              arrowtype.field("qty", ArrowInt64, false)])

    match pqarrow.parquet_schema_of(s)
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.assert_eq(list.len(p.columns), 2)
            test.assert_eq(p.columns[0].path, "price")
            test.assert_eq(p.columns[0].max_definition_level, 1)
            test.assert_eq(p.columns[1].max_definition_level, 0)

@test
fn test_a_schema_of_plain_numbers_has_nothing_unmappable() [io]
    test.assert_eq(list.len(pqarrow.unmappable_columns(two_leaves())), 0)

// ── Levels and offsets ──────────────────────────────────────────────

@test
fn test_repetition_levels_become_an_offsets_buffer() [io]
    // The column a.b.c over four records in five slots: repetition
    // 0 1 0 0 0, definition 3 2 0 1 3, each one bit-packed run.
    let page = hex("0302" + "034b03")
    let l = PqLevels { definition: arrowbuf.buffer(2, 3), repetition: arrowbuf.buffer(0, 2),
                       has_definition: true, has_repetition: true, max_definition: 3,
                       max_repetition: 1, count: 5 }
    let c = PqColumn { path: "a.b.c", segments: ["a", "b", "c"], physical: PqInt32,
                       type_length: 0, logical: PqLogNone, max_definition_level: 3,
                       max_repetition_level: 1 }
    var dst = room(256)

    match pqarrow.levels_to_offsets(page, l, c, dst)
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.assert(p.0 > 0)

            test.case("the element count is neither the five slots nor the two stored values")
            test.assert(p.1 != 5)
            test.assert(p.1 != 2)

@test
fn test_a_flat_array_has_no_repetition_stream_to_write() [io]
    match pqarrow.offsets_to_levels(bytes.zeros(24), three_ints(), qty())
        Ok(p)  => test.assert_eq(list.len(p.1), 0)
        Err(_) => test.assert(false)

// ── Chunks and batches ──────────────────────────────────────────────

@test
fn test_a_chunk_decodes_into_an_arrow_array_in_the_callers_body() [io]
    var dst = room(512)

    match pqarrow.chunk_to_array(qty_chunk_bytes(), 1000, qty_chunk(), qty(), [], a_config(), dst)
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.assert_eq(p.0.length, 10)
            test.assert_eq(p.0.null_count, 0)
            match p.0.data_type
                ArrowInt64 => test.assert(true)
                _          => test.assert(false)
            test.assert(p.1 >= 80)

@test
fn test_a_row_group_decodes_into_one_record_batch() [io]
    var dst = room(512)

    match pqarrow.row_group_to_batch(qty_chunk_bytes(), 1000, qty_footer([]), 0, ["qty"], [],
                                     a_config(), dst)
        Err(_) => test.assert(false)
        Ok(p)  =>
            test.assert_eq(p.0.rows, 10)
            test.assert_eq(list.len(p.0.columns), 1)

@test
fn test_a_batch_body_bound_covers_the_plain_values_at_least() [io]
    match pqarrow.batch_body_bound(qty_footer([]), 0, ["qty"])
        Ok(n)  => test.assert(n >= 80)
        Err(_) => test.assert(false)

    test.case("a row group the footer does not have is refused")
    match pqarrow.batch_body_bound(qty_footer([]), 1, ["qty"])
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_an_arrow_array_is_written_as_a_chunk_and_a_batch_as_a_row_group() [io]
    test.case("one array, two rows per page")
    var s1 = room(4096)
    var d1 = room(4096)
    let buf = PqPageBuf { raw_len: 0, packed_len: 0 }
    match pqarrow.array_to_chunk(qty_writer(), bytes.zeros(24), three_ints(), qty(), 2, buf, s1,
                                 d1)
        Ok(p)  => test.assert_eq(p.0.written, 4 + p.1)
        Err(_) => test.assert(false)

    test.case("one batch of that array closes one row group")
    var s2 = room(4096)
    var d2 = room(4096)
    let s = arrowtype.schema([arrowtype.field("qty", ArrowInt64, false)])
    let b = arrowcol.batch(s, [three_ints()], 3)
    match pqarrow.batch_to_row_group(qty_writer(), bytes.zeros(24), b, 2, buf, s2, d2)
        Ok(p)  => test.assert_eq(list.len(p.0.row_groups), 1)
        Err(_) => test.assert(false)

// ── The Arrow schema in the footer ──────────────────────────────────

@test
fn test_the_arrow_schema_is_stored_under_its_own_key_and_left_encoded() [io]
    test.assert_eq(pqarrow.arrow_schema_key(), "ARROW:schema")

    test.case("a footer that carries one says so and answers the base64 text as it is")
    test.assert(pqarrow.has_arrow_schema(qty_footer([arrow_entry()])))
    match pqarrow.arrow_schema_text(qty_footer([arrow_entry()]))
        Ok(t)  => test.assert_eq(t, "/////w==")
        Err(_) => test.assert(false)

    test.case("a footer that does not is not pretended to")
    test.assert(pqarrow.has_arrow_schema(qty_footer([])) == false)
    match pqarrow.arrow_schema_text(qty_footer([]))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_a_writer_stores_the_arrow_schema_text_it_was_given() [io]
    let w = pqarrow.with_arrow_schema(qty_writer(), "/////w==")
    test.assert_eq(list.len(w.key_value_metadata), 1)
    test.assert_eq(w.key_value_metadata[0].key, "ARROW:schema")
    test.assert_eq(w.key_value_metadata[0].value, "/////w==")
